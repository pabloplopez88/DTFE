From 26357715c208d01c92f7ec18253134815040b3f0 Mon Sep 17 00:00:00 2001
From: Pablo Lopez <plopez@unc.edu.ar>
Date: Mon, 5 Oct 2026 18:41:44 +0000
Subject: [PATCH 1/2] Fix velocity and scalar interpolation to the grid (bug in
 the original DTFE)

velocityValue() and scalarValue() computed the linear interpolation
v(x) = v_base + sum_j dv/dx_j (x_j - x_base_j) with '=' instead of '+=',
so only the last term of the sum was kept. The interpolated velocity
(and scalar fields), unaveraged and averaged with methods 1 and 2, were
wrong and depended on the particle order (i.e. on which vertex of each
Delaunay cell is the 'base'). The density, the velocity gradient and the
fields derived from it (divergence, shear, vorticity) were not affected.

Test: a linear velocity field v=(x,2y,-z) is now reproduced exactly at
the grid points (max error 1e-5 for |v|~300, before: 34) and the result
no longer depends on the order of the particles.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01C44ZCErHKsQgk681XW3FMn
---
 src/CGAL_triangulation/unaveraged_interpolation.cc | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/src/CGAL_triangulation/unaveraged_interpolation.cc b/src/CGAL_triangulation/unaveraged_interpolation.cc
index 7de5a2f..6b1ca67 100644
--- a/src/CGAL_triangulation/unaveraged_interpolation.cc
+++ b/src/CGAL_triangulation/unaveraged_interpolation.cc
@@ -108,12 +108,14 @@ inline Pvector<Real,noVelComp> velocityValue(Real velGrad[][noVelComp],
                                              Vertex_handle const & base,
                                              Point &samplePoint)
 {
+    // linear interpolation: v(x) = v_base + sum_j (dv/dx_j) * (x_j - x_base_j)
+    // (BUG FIX: the original code used '=' instead of '+=', so it kept only the last term of the sum)
     Pvector<Real,noVelComp> temp;
-    for (int i=0; i<NO_DIM; ++i)
+    for (size_t i=0; i<noVelComp; ++i)
     {
         temp[i] = 0.;
         for (int j=0; j<NO_DIM; ++j)
-            temp[i] = velGrad[j][i] * samplePoint[j];
+            temp[i] += velGrad[j][i] * samplePoint[j];
     }
     
     return temp + base->info().velocity();
@@ -156,7 +158,7 @@ Pvector<Real,noScalarComp> scalarValue(Real sGrad[][noScalarComp],
     {
         temp[i] = 0.;
         for (size_t j=0; j<NO_DIM; ++j)
-            temp[i] = sGrad[j][i] * samplePoint[j];
+            temp[i] += sGrad[j][i] * samplePoint[j];    // BUG FIX: '+=' instead of '=' (see velocityValue)
     }
     
     return temp + base->info().myScalar();
